{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papersoccer.example/schemas/flagship-study-manifest-v2.json",
  "title": "Paper Soccer flagship study manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study",
    "supersession",
    "source",
    "rules",
    "configurations",
    "candidate_grids",
    "openings",
    "seeds",
    "samples",
    "schedule",
    "latency_protocol",
    "selection_rule",
    "statistics",
    "outputs",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": "papersoccer.flagship-study-manifest.v2"
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "title", "study_class", "preregistered_at_utc",
        "frozen", "public_labels", "rank5_disclaimer"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "study_class": {"enum": ["flagship", "ci_smoke"]},
        "preregistered_at_utc": {"type": "string", "minLength": 1},
        "frozen": {"const": true},
        "public_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcts", "alpha_beta", "jacek_inspired", "rank5_derived"],
          "properties": {
            "mcts": {"type": "string"},
            "alpha_beta": {"type": "string"},
            "jacek_inspired": {"type": "string"},
            "rank5_derived": {
              "const": "Rank5DerivedBot — fixed 50k demo profile"
            }
          }
        },
        "rank5_disclaimer": {"type": "string", "minLength": 1}
      }
    },
    "supersession": {
      "description": "Legacy v4 lineage metadata. Historical attachments are archived in the flagship-study-v4-record tag and are not required in the working tree.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predecessor_manifest_path", "predecessor_manifest_sha256",
            "predecessor_status", "predecessor_test_outcomes_accessed",
            "predecessor_validation_results_used_for_v4_selection_or_calibration",
            "reused_opening_phases", "fresh_opening_phases",
            "fresh_validation_exclusion_scope"
          ],
          "properties": {
            "predecessor_manifest_path": {
              "const": "benchmarks/flagship_study/superseded/manifest-b7553a24.json",
              "description": "Path within the archived flagship-study-v4-record tag."
            },
            "predecessor_manifest_sha256": {
              "const": "b7553a24f618a77162cb256d65fd7cf21a854a10f46726c4a32cd57982ace9fe"
            },
            "predecessor_status": {
              "const": "stopped_before_test_calibration_implementation_defect"
            },
            "predecessor_test_outcomes_accessed": {"const": false},
            "predecessor_validation_results_used_for_v4_selection_or_calibration": {
              "const": false
            },
            "failure_record_path": {
              "const": "benchmarks/flagship_study/V3_VALIDATION_FAILURE.md",
              "description": "Deprecated path within the archived flagship-study-v4-record tag.",
              "deprecated": true
            },
            "failure_record_sha256": {
              "const": "e85407700a5280ab40974a53ba436bebedb399488a937f3f38f266c8e68f1cc1",
              "deprecated": true
            },
            "reused_opening_phases": {
              "const": ["development", "test"]
            },
            "fresh_opening_phases": {"const": ["validation"]},
            "fresh_validation_exclusion_scope": {
              "const": "all_predecessor_opening_banks"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit", "dirty_worktree", "analysis_contract_path",
        "analysis_contract_sha256", "arena_sha256", "opening_tool_sha256",
        "protected_artifacts"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_worktree": {"type": "boolean"},
        "analysis_contract_path": {"type": "string"},
        "analysis_contract_sha256": {"$ref": "#/$defs/sha256"},
        "arena_sha256": {"$ref": "#/$defs/sha256"},
        "opening_tool_sha256": {"$ref": "#/$defs/sha256"},
        "protected_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rank5_submission_path", "rank5_submission_sha256",
            "jacek_model_path", "jacek_model_sha256"
          ],
          "properties": {
            "rank5_submission_path": {"type": "string"},
            "rank5_submission_sha256": {"$ref": "#/$defs/sha256"},
            "jacek_model_path": {"type": "string"},
            "jacek_model_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width", "height", "goal_rule", "blocked_rule", "playable_edges",
        "max_game_plies", "maximum_game_length_policy", "opening_ply_definition",
        "natural_draws"
      ],
      "properties": {
        "width": {"const": 8},
        "height": {"const": 10},
        "goal_rule": {"const": "opponent_goal_only"},
        "blocked_rule": {"const": "player_to_move_loses"},
        "playable_edges": {"const": 316},
        "max_game_plies": {"const": 512},
        "maximum_game_length_policy": {"type": "string"},
        "opening_ply_definition": {"type": "string"},
        "natural_draws": {"const": false}
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/configuration"}
    },
    "candidate_grids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcts", "alpha_beta", "jacek_inspired", "rank5_derived"],
      "properties": {
        "mcts": {"$ref": "#/$defs/idArray"},
        "alpha_beta": {"$ref": "#/$defs/idArray"},
        "jacek_inspired": {"$ref": "#/$defs/idArray"},
        "rank5_derived": {"$ref": "#/$defs/idArray"}
      }
    },
    "openings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "depths", "banks"],
      "properties": {
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "description", "selection", "terminal_rejection",
            "duplicate_policy", "canonical_equivalence", "state_hash_algorithm"
          ],
          "properties": {
            "id": {"const": "uniform-legal-move-generator/v1"},
            "description": {"type": "string"},
            "selection": {"type": "string"},
            "terminal_rejection": {"type": "string"},
            "duplicate_policy": {"type": "string"},
            "canonical_equivalence": {"type": "string"},
            "state_hash_algorithm": {"type": "string"}
          }
        },
        "depths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "banks": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/openingBank"}
        }
      }
    },
    "seeds": {"$ref": "#/$defs/seedContract"},
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "validation", "test"],
      "properties": {
        "development": {"$ref": "#/$defs/sample"},
        "validation": {"$ref": "#/$defs/sample"},
        "test": {"$ref": "#/$defs/sample"}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tuning", "test"],
      "properties": {
        "tuning": {"type": "array", "items": {"$ref": "#/$defs/tuningMatchup"}},
        "test": {"type": "array", "items": {"$ref": "#/$defs/testMatchup"}}
      }
    },
    "latency_protocol": {"type": "object"},
    "selection_rule": {"type": "object"},
    "statistics": {"type": "object"},
    "outputs": {"type": "object"},
    "environment": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "idArray": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "kind", "public_label", "role", "settings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"enum": ["mcts", "alpha_beta", "jacek_inspired", "rank5_derived"]},
        "kind": {"enum": ["mcts", "alpha-beta", "jacek-inspired", "rank5-derived"]},
        "public_label": {"type": "string", "minLength": 1},
        "role": {"enum": ["candidate", "fixed_comparator"]},
        "settings": {"type": "object"}
      }
    },
    "openingBank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "depth", "pairs", "path", "sha256", "seed"],
      "properties": {
        "id": {"type": "string"},
        "phase": {"enum": ["development", "validation", "test"]},
        "depth": {"type": "integer", "minimum": 1},
        "pairs": {"type": "integer", "minimum": 1},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"$ref": "#/$defs/seed"}
      }
    },
    "phaseSeeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "validation", "test"],
      "properties": {
        "development": {"$ref": "#/$defs/seed"},
        "validation": {"$ref": "#/$defs/seed"},
        "test": {"$ref": "#/$defs/seed"}
      }
    },
    "seedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "bot", "bootstrap", "calibration", "analysis"],
      "properties": {
        "opening": {"type": "object"},
        "bot": {"$ref": "#/$defs/phaseSeeds"},
        "bootstrap": {"$ref": "#/$defs/phaseSeeds"},
        "calibration": {
          "type": "object", "additionalProperties": false,
          "required": ["validation"],
          "properties": {"validation": {"$ref": "#/$defs/seed"}}
        },
        "analysis": {"$ref": "#/$defs/phaseSeeds"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color_swapped_pairs_per_depth_matchup", "games_per_pair"],
      "properties": {
        "color_swapped_pairs_per_depth_matchup": {"type": "integer", "minimum": 1},
        "games_per_pair": {"const": 2}
      }
    },
    "tuningMatchup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "candidate", "opponent", "phases"],
      "properties": {
        "id": {"type": "string"}, "candidate": {"type": "string"},
        "opponent": {"type": "string"},
        "phases": {"const": ["development", "validation"]}
      }
    },
    "testMatchup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "left_slot", "right_slot"],
      "properties": {
        "id": {"type": "string"}, "left_slot": {"type": "string"},
        "right_slot": {"type": "string"}
      }
    }
  }
}
